# Local development values, read by Vite when you run `npm run dev`.
# Copy this file to `.env.local` and fill in your own Supabase project -
# `.env.local` is gitignored and never committed.
VITE_SYNTHESIS_ENDPOINT=http://localhost:8787
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
