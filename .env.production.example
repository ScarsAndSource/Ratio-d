# Production build values, read by Vite at `npm run build` time.
# Copy this file to `.env.production.local` (gitignored) when building for
# a real deploy, or set these as environment variables in your host's
# build settings (Vercel/Netlify/Cloudflare Pages project settings, etc).
#
# VITE_SYNTHESIS_ENDPOINT must point at your deployed Cloudflare Worker
# (from `wrangler deploy --env production`), NOT localhost:8787.
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY must be the SAME Supabase
# project you configured in worker/wrangler.toml under [env.production.vars]
# - a mismatch here means the frontend and worker are checking two
# different Supabase projects, and every request will fail auth.
VITE_SYNTHESIS_ENDPOINT=https://REPLACE-WITH-YOUR-DEPLOYED-WORKER-URL
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
